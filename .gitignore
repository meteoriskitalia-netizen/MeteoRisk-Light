# ---- Dati grezzi : MAI committati / pubblicati / deployati ----
# L'eccezione .gitkeep mantiene la struttura a runtime; i contenuti sono
# rigenerati dalla pipeline e vanno esclusi dal repository.
data/_raw/*
!data/_raw/.gitkeep
data/_staging/*
!data/_staging/.gitkeep
data/_workdir/*
!data/_workdir/.gitkeep

# Backup interni (publish) / report efficienza / coordinate rigenerabili
data/state/_latest_backup/
data/workdir-tmp/

# ---- Python ----
__pycache__/
*.pyc
*.pyo

# ---- OS / editor ----
Thumbs.db
.DS_Store
.vscode/
.idea/